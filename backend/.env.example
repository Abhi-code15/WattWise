PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wattwise?schema=public"
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN="7d"
SIMULATOR_API_KEY=replace-with-a-random-api-key
SIMULATOR_INTERVAL_MS=15000
SIMULATOR_AUTOSTART=true
DEFAULT_TARIFF_RATE=7.50
OFFLINE_TIMEOUT_SECONDS=90
STALE_TIMEOUT_SECONDS=45
HIGH_POWER_CONSECUTIVE_READINGS=10
